# ==============================================================================
# .env.example - Plantilla de Variables de Entorno
# ==============================================================================
# Explicación para alumnos:
# Copiá este archivo con el nombre '.env' en la raíz del proyecto y completá
# tus valores reales. El archivo '.env' real está en .gitignore para que
# tus contraseñas y API keys privadas nunca se suban a GitHub.
# ==============================================================================

# Clave secreta criptográfica de Django (En producción debe ser un string largo y aleatorio)
SECRET_KEY=django-insecure-plantilla-didactica-super-secreta-para-clases-123456789

# Modo depuración (True para desarrollo local, False para producción)
DEBUG=True

# Dominios / IPs permitidos para acceder al servidor (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración de Base de Datos PostgreSQL
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
# En Docker el host es 'db'. En desarrollo local nativo suele ser 'localhost'.
DATABASE_URL=postgres://django_user:django_pass@db:5432/django_db

# Switch de activación del Módulo Manual/Guía del Alumno (True = visible, False = oculto)
ENABLE_STUDENT_MANUAL=True

# Backend de Email (console para ver emails en la terminal en desarrollo local)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# API Key de Anthropic para consultas asistidas por IA (Claude)
# Obtenela en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui
